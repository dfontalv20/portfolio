---
import { getEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import taraLaptop from "../assets/tara_laptop.webp";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
const tara = await getEntry("projects", "tara")!;
const { title, tags, description, logo, sections } = tara?.data;
---

<ProjectCard
  class="animate-slide font-readex-pro relative grid grid-rows-[auto_1fr_auto] gap-4 border-4 bg-[#7B161C] p-[4%] lg:grid-cols-[30%_1fr] lg:grid-rows-2"
>
  <div>
    <Image
      src={logo}
      alt="Tara logo"
      class="w-1/3 object-contain lg:h-full lg:w-auto"
    />
  </div>

  <button
    class="relative w-full md:row-span-2"
    commandfor="tara_details"
    command="show-modal"
    id="tara_open_btn"
  >
    <Image
      src={taraLaptop}
      alt="Tara login"
      role="button"
      loading="lazy"
      class="absolute -top-1/2 right-1/2 size-full translate-1/2 object-contain transition-all hover:scale-110 hover:-rotate-3 hover:cursor-pointer"
    />
  </button>
  <p
    class="font-inter mt-auto text-center text-2xl font-medium text-white lg:text-left lg:text-4xl"
  >
    {description}
  </p>
</ProjectCard>

<dialog
  id="tara_details"
  class:list={[
    "font-readex-pro h-full max-h-full max-w-full overflow-auto overscroll-contain bg-[#7B161C] p-6 text-white md:px-16 md:py-20",
    "translate-y-full opacity-0 transition-all transition-discrete duration-500 ease-in-out open:translate-y-0 open:opacity-100 starting:open:translate-y-full",
  ]}
>
  <button
    id="tara_close_details"
    commandfor="tara_details"
    command="close"
    class="absolute top-0 right-0 m-9 cursor-pointer rounded-full p-4 text-xl uppercase transition-colors hover:bg-white/10"
    ><Icon name="mdi:close" class="size-10" /></button
  >

  <div
    class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-[repeat(auto-fit,minmax(500px,1fr))]"
  >
    <div class="mb-4 text-5xl">
      {
        logo ? (
          <Image
            src={logo}
            alt={title ?? "Logo"}
            class="mb-4 size-20 object-contain"
          />
        ) : (
          <h1 class="mb-4 text-2xl font-bold">{title}</h1>
        )
      }
      <p class="text-2xl md:text-5xl xl:text-[clamp(3rem,4vw,5rem)]">
        {sections.overview.content}
      </p>
    </div>
    <Image class="self-center" src={taraLaptop} alt="Tara platform" />
  </div>

  <!-- GOAL + STACK -->
  <div
    class="grid grid-cols-1 justify-between gap-4 border-b border-white/10 py-6 md:grid-cols-[1fr_30%]"
  >
    <div class="flex items-center gap-5">
      <div
        class="flex size-12 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/8"
      >
        <Icon class="text-4xl text-white/60" name="mdi:bullseye" />
      </div>
      <div>
        <p class="mb-1 tracking-widest text-white/40 uppercase">Goal</p>
        <p class="max-w-xl text-lg leading-snug font-medium text-white">
          Optimize access to and management of information related to academic
          tutoring services.
        </p>
      </div>
    </div>
    <div>
      <p class="mb-1 tracking-widest text-white/40 uppercase">Stack</p>
      <div class="flex flex-wrap items-center gap-4">
        {
          tags.map((tag) => (
            <span class="inline-block rounded-full bg-white/10 px-3 py-1 text-sm text-white">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <!-- PROBLEM + VALUE PROPOSITION -->
  <div class="grid grid-cols-1 border-b border-white/10 md:grid-cols-2">
    <div class="border-white/10 py-6 md:border-r md:pr-8">
      <p
        class="mb-4 flex items-center gap-2 tracking-widest text-white/40 uppercase"
      >
        Problem
      </p>
      <ul class="space-y-3">
        {
          (sections.problem.content as string[]).map((line, index) => (
            <li class="flex items-start gap-3 leading-snug text-white">
              <span class="min-w-4.5 pt-px font-medium text-white/25">
                {(index + 1).toString().padStart(2, "0")}
              </span>
              {line}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="py-6 md:pl-8">
      <p
        class="mb-4 flex items-center gap-2 tracking-widest text-white/40 uppercase"
      >
        Value proposition
      </p>
      <ul class="space-y-3">
        {
          (sections.value_proposition.content as string[]).map((line) => (
            <li class="flex items-center gap-3 leading-snug text-white">
              <span
                class="flex size-4.5 shrink-0 items-center justify-center rounded-full border text-[11px]"
                style="background:rgba(100,220,160,0.15); border-color:rgba(100,220,160,0.4); color:rgba(100,220,160,0.9);"
              >
                <Icon class="text-xs" name="mdi:check" />
              </span>
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="py-6">
    <p
      class="mb-4 flex items-center gap-2 tracking-widest text-white/40 uppercase"
    >
      Features
    </p>
    <div class="grid grid-cols-1 gap-2.5 md:grid-cols-2 lg:grid-cols-5">
      {
        (sections.features.content as string[]).map((feature, index) => (
          <div class="group flex cursor-default flex-col gap-2 rounded-xl border border-white/10 bg-white/5 p-3.5 transition-colors duration-200 hover:bg-white/10">
            <Icon
              class="text-2xl text-white/40"
              name={
                [
                  "mdi:view-dashboard-outline",
                  "mdi:calendar",
                  "mdi:database-outline",
                  "mdi:clipboard-check-outline",
                  "mdi:graph-bar",
                ][index]
              }
            />
            <span class="text-base leading-snug text-white/75">{feature}</span>
          </div>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  import { logEvent } from "@/lib/firebase";
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("tara_open_btn");
    btn?.addEventListener("click", () => {
      logEvent("open_project_details", { project: "tara" });
    });
  });
</script>

<style>
  .animate-slide {
    position: relative;
    &::before {
      animation: slide 60s linear infinite;
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0.15;
      background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-rule='evenodd'%3E%3Ccircle cx='20' cy='20' r='2'/%3E%3C/g%3E%3C/svg%3E");
      pointer-events: none;
    }
  }
  @keyframes slide {
    0% {
      background-position: -2000px 2000px;
    }
    100% {
      background-position: 2000px -2000px;
    }
  }
</style>
