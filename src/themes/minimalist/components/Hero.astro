---
import Screen from "@/themes/minimalist/assets/screen.webp";
import Case from "@/themes/minimalist/assets/case.webp";
import Plant from "@/themes/minimalist/assets/plant.webp";
---

<section class="flex flex-col items-center overflow-hidden pt-20 text-center">
  <h1
    id="hero"
    class="font-readex-pro mb-7 px-10 text-center text-6xl leading-none opacity-0 transition-opacity transition-discrete duration-500 sm:text-8xl md:mb-10 md:text-9xl lg:mb-24 lg:text-[clamp(160px,10vw,1000px)]"
  >
    Diego Fontalvo
  </h1>
  <div
    class="relative isolate grid w-max grid-cols-1 justify-center gap-10 overflow-hidden md:grid-cols-3"
  >
    <img
      src={Plant.src}
      class="relative -bottom-30 z-10 hidden h-min self-end justify-self-end object-contain md:block"
    />

    <!-- Monitor -->
    <div
      class="relative -bottom-10 isolate z-20 w-185.5 max-w-[95vw] min-w-0 shrink-0 self-end md:-bottom-1/6"
    >
      <img src={Screen.src} class="pointer-events-none select-none" />
      <div class="absolute inset-0 -z-10 w-full p-[1%]">
        <div
          class="bg-accent-1 flex aspect-video w-full flex-col overflow-hidden text-xs text-nowrap sm:text-base"
        >
          <div
            class="font-readex-pro text-accent-2 border-accent-3 grid place-items-center border-b p-2 text-center"
          >
            portfolio.js
          </div>
          <div class="grid flex-1 grid-cols-[auto_1fr] gap-3 px-3 py-4">
            <div class="text-accent-3 font-roboto-mono text-right">
              {
                Array.from({ length: 15 }, (_, i) => i + 1).map((n) => (
                  <div>{n}</div>
                ))
              }
            </div>
            <div class="font-roboto-mono text-left" id="portfolio-code"></div>
          </div>
        </div>
      </div>
    </div>

    <img
      src={Case.src}
      class="relative -bottom-20 z-10 hidden size-max shrink-0 self-end justify-self-start object-cover md:block"
    />

    <div
      class="bg-accent-2 absolute right-1/2 bottom-0 h-1/2 w-full max-w-[97vw] translate-x-1/2 rounded-3xl"
    >
    </div>
  </div>
</section>

<script>
  import Typed from "typed.js";
  new Typed("#portfolio-code", {
    strings: [
      [
        '<span class="text-accent-5">const </span>',
        '<span class="text-white">portfolio</span>',
        '<span class="text-accent-2"> = </span>',
        '<span class="text-accent-5">new</span>',
        '<span class="text-white"> Portfolio() </span>',
        "</br>",
        `<span class="text-white">portfolio</span><span class="text-accent-5"
        >.showHeroTitle</span
      ><span class="text-white"
        >()</span
      >`,
      ].join(""),
    ],
    typeSpeed: 25,
    cursorChar: "|",
    showCursor: true,
    onComplete: () =>
      document.getElementById("hero")?.classList.toggle("opacity-0"),
  });
</script>
